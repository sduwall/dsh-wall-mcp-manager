{
  "name": "@sduwall/dsh-wall-mcp-manager",
  "version": "0.1.0",
  "description": "DSH 插件：集中管理 MCP 服务配置，并展示每个 MCP 的工具清单、参数与返回契约",
  "license": "MIT",
  "author": "sduwall",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sduwall/dsh-wall-mcp-manager.git"
  },
  "bugs": {
    "url": "https://github.com/sduwall/dsh-wall-mcp-manager/issues"
  },
  "homepage": "https://github.com/sduwall/dsh-wall-mcp-manager#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "mcp-manager",
    "sduwall"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6"
  },
  "scripts": {
    "test": "node tests/inventory.test.mjs && node tests/mcp-bridge.test.mjs && node tests/client-bundle.test.mjs",
    "prepublishOnly": "npm test"
  }
}
